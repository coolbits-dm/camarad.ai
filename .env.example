# Camarad runtime mode.
# Hosted SaaS should opt into platform_default explicitly.
# Open-source/self-hosted should use byok and provide its own server-side key.
CAMARAD_DISTRIBUTION=self_hosted
CAMARAD_PROVIDER_MODE=byok
ALLOW_PLATFORM_DEFAULT_PROVIDER=false

# Instance BYOK for self-hosted, or platform key for hosted when explicitly enabled.
# Never commit real secrets.
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-4.1-mini
OPENAI_PROJECT_ID=

# Existing app settings.
DEBUG=0
SECRET_KEY=change-me
DATABASE=camarad.db
HOST=127.0.0.1
PORT=5051
